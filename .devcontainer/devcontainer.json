{
  "name": "Agent Harness Engineering",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": { "cpus": 2 },
  "postCreateCommand": "make setup && make data",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"],
      "settings": { "python.testing.pytestEnabled": true }
    }
  },
  "secrets": {
    "ANTHROPIC_API_KEY": { "description": "Your Anthropic API key (with a monthly spend limit)." }
  }
}
